<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Zero-config: instantiated at process start so :media can capture the application Context
             for the PoToken WebView. authorities is suffixed with ${applicationId} to stay unique. -->
        <provider
            android:name="pro.jayeshseth.media.MediaContextProvider"
            android:authorities="${applicationId}.media-context-provider"
            android:exported="false"
            android:initOrder="100" />
    </application>
</manifest>
